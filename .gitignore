# 依赖文件夹
node_modules/
vendor/

# 打包输出
dist/
build/
out/
pdf/

# 系统文件 (Windows)
Thumbs.db
.DS_Store
*.log
*.tmp
*.temp

# 编辑器配置
.idea/
.vscode/
*.swp
*.swo

# 密码/配置
.env
config.local.js
password.txt
task.md
记录.md

